      "id": 8,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "filters": [],
          "limit": 50,
          "query": "{resource.service.name=\"smc-backend\" && resource.deployment.environment.name=\"$env\"}",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent traces",
      "type": "table"
    }
  ],
