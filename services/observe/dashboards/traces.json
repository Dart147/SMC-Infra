      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, language) (rate(smc_judge_duration_seconds_bucket[5m])))",
          "legendFormat": "{{language}}",
          "refId": "A"
        }
      ],
      "title": "p95 judge duration by language",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "HTTP request spans slower than $min_duration. Spans are named 'METHOD /path' (summer middleware logs raw path, not route pattern — known SDC anti-pattern, accepted). Click a trace ID to open it; tracesToLogsV2 links back to Loki.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 4,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{resource.service.name=\"smc-backend\" && resource.deployment.environment.name=\"$env\" && name=~\"(GET|POST|PUT|PATCH|DELETE) .*\" && duration > $min_duration}",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Slow requests (> $min_duration)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Traces containing an errored span or a RecordError exception event. Note: summer's middleware never sets span status, so HTTP 4xx/5xx alone won't appear here — only spans where service code recorded the error. Status-code triage lives in the metrics/logs dashboards.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 5,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{resource.service.name=\"smc-backend\" && resource.deployment.environment.name=\"$env\" && (status=error || event:name=\"exception\")}",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Error traces",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Async judge runs — each is its own root span (the HTTP span ends at enqueue; span links across the hop are a deferred follow-up). Identifier attributes only; verdict/score never appear on spans (domain rule, pinned by tests).",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{resource.service.name=\"smc-backend\" && resource.deployment.environment.name=\"$env\" && name=\"judge.submission\"} | select(span.submission_id, span.problem_id, span.language)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Judge runs (judge.submission)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Sandbox executions (async judge + synchronous /api/run sample) over 10 s — runaway / timeout candidates. Kill-a-grader fault-tolerance demos show up here.",
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "options": {},
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "filters": [],
          "limit": 20,
          "query": "{resource.service.name=\"smc-backend\" && resource.deployment.environment.name=\"$env\" && name=~\"judge\\\\.submission|SubmissionService\\\\.RunSample\" && duration > 10s} | select(span.problem_id, span.language)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Slow sandbox runs (> 10s)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "description": "Drill-down tail: the most recent traces, unfiltered (HTTP + judge roots). The trace-table analog of the logs dashboard's live tail.",
      "fieldConfig": {
