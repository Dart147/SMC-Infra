    {
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Share of log lines at level=error over the last 5m. Noisy at idle traffic: summer logs 4xx (scanner hits) at Error level, so a quiet site can sit high.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "max": 1,
          "min": 0,
          "noValue": "no logs in window",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({app=\"smc-backend\", env=\"$env\", level=\"error\"}[5m])) / sum(rate({app=\"smc-backend\", env=\"$env\"}[5m]))",
          "legendFormat": "error ratio",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Error ratio",
      "type": "stat"
    },
